# API 서버 주소 (puppynote-server)
# 예) 로컬: http://localhost:8080 / 개발: https://dev-api.puppynote.co.kr
VITE_API_URL=http://localhost:8080

# 요청 타임아웃 (ms). 비워두면 10000
VITE_API_TIMEOUT=10000

# 카카오맵 JS SDK 앱 키 (산책 상세의 위치 지도). https://developers.kakao.com 앱 설정 > 플랫폼 > Web에
# 서비스 도메인을 등록해야 합니다.
VITE_KAKAO_MAP_APP_KEY=
